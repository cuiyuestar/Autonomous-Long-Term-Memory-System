# Shared OpenAI-compatible chat model. Stage-specific values inherit these.
ALTM_LLM_BASE_URL=https://example.com/v1
ALTM_LLM_API_KEY=
ALTM_LLM_MODEL=
ALTM_LLM_TIMEOUT_SECONDS=60

# Optional per-stage overrides. Leave empty to inherit ALTM_LLM_*.
ALTM_L1_LLM_BASE_URL=
ALTM_L1_LLM_API_KEY=
ALTM_L1_LLM_MODEL=
ALTM_L1_LLM_TIMEOUT_SECONDS=

ALTM_L2_LLM_BASE_URL=
ALTM_L2_LLM_API_KEY=
ALTM_L2_LLM_MODEL=
ALTM_L2_LLM_TIMEOUT_SECONDS=

ALTM_GRAPH_LLM_BASE_URL=
ALTM_GRAPH_LLM_API_KEY=
ALTM_GRAPH_LLM_MODEL=
ALTM_GRAPH_LLM_TIMEOUT_SECONDS=

ALTM_GOVERNANCE_LLM_BASE_URL=
ALTM_GOVERNANCE_LLM_API_KEY=
ALTM_GOVERNANCE_LLM_MODEL=
ALTM_GOVERNANCE_LLM_TIMEOUT_SECONDS=

# L3/L4 semantic evaluator chain. Each stage inherits ALTM_LLM_* when empty.
ALTM_RERANKER_LLM_MODEL=
ALTM_NLI_LLM_MODEL=
ALTM_SCOPE_LLM_MODEL=
ALTM_L3_LLM_MODEL=
ALTM_L4_LLM_MODEL=
ALTM_SEMANTIC_MIN_SCORE=0.80
ALTM_L3_OBSERVATION_DAYS=7
ALTM_L4_OBSERVATION_DAYS=30
ALTM_L4_OVERWRITE_MIN_CONFIDENCE=0.90
ALTM_HEADROOM_LLM_MODEL=

# Lifecycle and retention. 0 keeps L0 permanently unless explicitly deleted.
ALTM_LONG_MEMORY_TOKEN_BUDGET=100000
ALTM_L0_RETENTION_DAYS=0

# OpenAI-compatible embedding model.
ALTM_EMBEDDING_BASE_URL=https://example.com/v1
ALTM_EMBEDDING_API_KEY=
ALTM_EMBEDDING_MODEL=
ALTM_EMBEDDING_TIMEOUT_SECONDS=60
ALTM_EMBEDDING_BATCH_SIZE=10

# Optional exact token budgeting.
ALTM_CONTEXT_TOKENIZER=tiktoken
ALTM_CONTEXT_TOKENIZER_MODEL=

# Required for SSE/Streamable HTTP. Store only SHA-256 hashes, never plaintext.
ALTM_MCP_API_KEY_SHA256=
ALTM_MCP_API_KEYS_JSON=
ALTM_MCP_ISSUER_URL=http://localhost
ALTM_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp

# Optional OIDC/JWT extension: module.path:factory returning TokenVerifier.
ALTM_MCP_TOKEN_VERIFIER_FACTORY=

# DeepSeek Harness adapter. The plaintext key exists only in the client
# credential store or process environment; the server keeps its SHA-256 above.
DSH_HOME=
DEEPSEEK_API_KEY=
ALTM_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
ALTM_MCP_API_KEY=
ALTM_MCP_API_KEY_ENV=ALTM_MCP_API_KEY
ALTM_TENANT_ID=local
ALTM_WORKSPACE_ID=
ALTM_USER_ID=
ALTM_AGENT_ID=deepseek-harness

# Hermes adapter. ALTM_API_KEY is plaintext on the client only.
ALTM_API_KEY=
ALTM_HERMES_MCP_SERVER_NAME=altm
ALTM_HERMES_TENANT_ID=local
ALTM_HERMES_WORKSPACE_ID=default
ALTM_HERMES_USER_ID=
ALTM_HERMES_AGENT_ID=hermes
ALTM_HERMES_TOKEN_BUDGET=1200
ALTM_HERMES_RECALL_LIMIT=10
ALTM_HERMES_ACTIVE_LIMIT=5

# Required only while anonymizing real Agent traces; never write the salt to reports.
ALTM_TRACE_ANONYMIZATION_SALT=
ALTM_GIT_COMMIT=
