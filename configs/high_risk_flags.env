# ALTM 高风险行为开关。
# 使用方式：source configs/high_risk_flags.env
# 约定：所有开关统一使用 ALTM_ 前缀，并按当前项目决策默认设为 true。

# 默认在 build-context 主链路中启用 Global Active Window 融合。
export ALTM_ENABLE_DEFAULT_ACTIVE_WINDOW_IN_BUILD_CONTEXT=true

# 对被 Active Window 选中或注入的记忆启用分级生命周期反馈。
export ALTM_ENABLE_ACTIVE_WINDOW_LIFECYCLE_FEEDBACK=true

# 允许 L4/persona 记忆在低配额、高阈值策略下进入 Active Window。
export ALTM_ENABLE_L4_PERSONA_ACTIVE_WINDOW=true

# 启用 L4/persona 候选合成，默认只生成 observing 候选并进入 Review Queue。
export ALTM_ENABLE_L4_PERSONA_CANDIDATES=true

# 启用跨会话 L3 场景发现，但仅作为候选项，不自动激活。
export ALTM_ENABLE_CROSS_SESSION_L3_CANDIDATES=true

# 在合并执行器实现后，对高相似度 L2 记忆启用自动合并。
export ALTM_ENABLE_AUTO_L2_SEMANTIC_MERGE=true

# 当自动合并选出规范记忆后，对重复 L2 记忆启用自动墓碑标记。
export ALTM_ENABLE_AUTO_L2_TOMBSTONE=true

# 启用基于可选 tokenizer 的 Context Gateway 预算控制；tokenizer 不可用时回退。
export ALTM_ENABLE_OPTIONAL_CONTEXT_TOKENIZER=true

# 在事件表结构与投影器实现后，启用事件溯源式 Review Audit 演进。
export ALTM_ENABLE_REVIEW_EVENT_SOURCING=true

# 在追加式 Review 事件之上启用派生审计投影与摘要。
export ALTM_ENABLE_REVIEW_AUDIT_PROJECTIONS=true

# 总开关：记录本文件中的高风险决策当前默认全部启用。
export ALTM_ENABLE_HIGH_RISK_DEFAULTS=true
